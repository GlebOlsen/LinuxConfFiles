{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "key": { "width": 14 },
    "color": { "title": "blue", "separator": "90" }
  },
  "modules": [
    { "type": "title", "format": "{#1;34}{user-name}{#0}{#90}@{#1;34}{host-name}" },
    "break",

    // System
    { "type": "os", "key": "󰌽  OS", "keyColor": "blue" },
    { "type": "disk", "key": "󰃭  OS Age", "keyColor": "blue", "folders": "/", "format": "{years} years, {days-of-year} days (since {create-time:10})" },
    { "type": "kernel", "key": "  Kernel", "keyColor": "blue" },
    { "type": "initsystem", "key": "󰒓  Init", "keyColor": "blue" },
    { "type": "uptime", "key": "󰅐  Uptime", "keyColor": "blue" },
    { "type": "packages", "key": "󰏖  Packages", "keyColor": "blue" },
    { "type": "locale", "key": "󰇧  Locale", "keyColor": "blue" },
    "break",

    // Hardware
    { "type": "host", "key": "󰪫  Host", "keyColor": "green" },
    { "type": "bios", "key": "󰘚  BIOS", "keyColor": "green" },
    { "type": "cpu", "key": "  CPU", "keyColor": "green" },
    { "type": "gpu", "key": "󰢮  GPU", "keyColor": "green" },
    { "type": "memory", "key": "󰍛  Memory", "keyColor": "green" },
    { "type": "swap", "key": "󰓡  Swap", "keyColor": "green" },
    { "type": "disk", "key": "󰋊  Disk", "keyColor": "green", "folders": "/" },
    "break",

    // Desktop
    { "type": "wm", "key": "󰕮  WM", "keyColor": "magenta", "format": "{pretty-name}{?version} {version}{?}{?protocol-name} ({protocol-name}){?}" },
    { "type": "theme", "key": "󰏘  Theme", "keyColor": "magenta" },
    { "type": "icons", "key": "󰀻  Icons", "keyColor": "magenta" },
    { "type": "font", "key": "󰊄  Font", "keyColor": "magenta" },
    { "type": "cursor", "key": "󰇀  Cursor", "keyColor": "magenta" },
    { "type": "display", "key": "󰍹  Displays", "keyColor": "magenta", "compactType": "original" },
    "break",

    // Terminal
    { "type": "shell", "key": "󱆃  Shell", "keyColor": "cyan" },
    { "type": "editor", "key": "󰏫  Editor", "keyColor": "cyan" },
    { "type": "terminal", "key": "󰆍  Terminal", "keyColor": "cyan" },
    { "type": "terminalfont", "key": "󰬴  Term Font", "keyColor": "cyan" },
    "break",

    // Network
    { "type": "localip", "key": "󰩠  Local IP", "keyColor": "yellow" },
    { "type": "version", "key": "󰋽  Fetch", "keyColor": "yellow" },

    // colour squares
    "break",
    { "type": "custom", "format": "\u001b[22;30m█\u001b[100m▀▀\u001b[49m█  \u001b[22;31m█\u001b[101m▀▀\u001b[49m█  \u001b[22;32m█\u001b[102m▀▀\u001b[49m█  \u001b[22;33m█\u001b[103m▀▀\u001b[49m█  \u001b[22;34m█\u001b[104m▀▀\u001b[49m█  \u001b[22;35m█\u001b[105m▀▀\u001b[49m█  \u001b[22;36m█\u001b[106m▀▀\u001b[49m█  \u001b[22;37m█\u001b[107m▀▀\u001b[49m█\u001b[0m" },
    { "type": "custom", "format": "\u001b[22;30m█\u001b[100m▄▄\u001b[49m█  \u001b[22;31m█\u001b[101m▄▄\u001b[49m█  \u001b[22;32m█\u001b[102m▄▄\u001b[49m█  \u001b[22;33m█\u001b[103m▄▄\u001b[49m█  \u001b[22;34m█\u001b[104m▄▄\u001b[49m█  \u001b[22;35m█\u001b[105m▄▄\u001b[49m█  \u001b[22;36m█\u001b[106m▄▄\u001b[49m█  \u001b[22;37m█\u001b[107m▄▄\u001b[49m█\u001b[0m" }
  ]
}
