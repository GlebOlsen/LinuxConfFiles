[25]  # Version number. Do not delete.

# Rice green: very dark green background, high-contrast syntax after the Helix rainbow9 theme
# (repo\linuxconffiles\terminalEditors\helix\themes\rainbow9.toml). Few colors, everything else white.
#   keyword FF00FF  function 00FF00  type 3399FF  constant FFFF00  string FF8000
#   operator 00FFFF  comment 808080  text FFFFFF  cursor B3FF00  selection 3A4A00

